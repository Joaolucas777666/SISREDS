{
    "manifest_version": 3,
    "name": "SISREDS",
    "version": "1.0.0",
    "description": "Sistema Inteligente de Segurança em Redes Sociais!",
    
    "action": {
        "default_popup": "popup.html"  
    },

    "permissions": [
        "storage"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ],  

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}